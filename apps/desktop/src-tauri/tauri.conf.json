{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TermBridge",
  "version": "0.2.1",
  "identifier": "dev.termbridge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TermBridge",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/termbridge"
    ]
  }
}
